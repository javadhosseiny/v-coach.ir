<IfModule mod_rewrite.c>
Options -Indexes
RewriteEngine on

#RewriteCond %{HTTP_HOST} !^www\. [NC]
#RewriteRule ^(.*)$ https://www.%{HTTP_HOST}/$1 [L,R=301]
#RewriteCond %{HTTPS} !=on
#RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301] 

RewriteRule ^index\.php$ / [R=301]

RewriteRule ^login/$ /LoginUser.php
RewriteRule ^login-email/$ /LoginUser.php?reg_type=1
RewriteRule ^register/$ /AddUser.php
RewriteRule ^register-email/$ /AddUser.php?reg_type=1
RewriteRule ^recover/$ /RecoverUser.php
RewriteRule ^recover-email/$ /RecoverUser.php?reg_type=1

#RewriteRule ^login/$ /loginuser.php
#RewriteRule ^login-email/$ /loginuser.php?reg_type=1
#RewriteRule ^register/$ /adduser.php
#RewriteRule ^register-email/$ /adduser.php?reg_type=1
#RewriteRule ^recover/$ /recoveruser.php
#RewriteRule ^recover-email/$ /recoveruser.php?reg_type=1

RewriteRule ^conditions/$ /conditions-us.php
RewriteRule ^contactus/$ /contact-us.php
RewriteRule ^profile/$ /userprofile.php [L,QSA]
RewriteRule ^myorder/([^/]*)$ /userorder.php?id=$1
RewriteRule ^myaddres$ /useraddres.php
RewriteRule ^myaddres/([^/]*)$ /useraddres.php?id=$1
RewriteRule ^myfavorite/$ /userfav.php
RewriteRule ^mypassword/$ /userpass.php
RewriteRule ^logout$ /userlogout.php
RewriteRule ^shoppingcard/$ /usershopping.php
RewriteRule ^shoppingcardfinal/$ /usershopping.php?level=2
RewriteRule ^sitemap/$ /site-map.php
RewriteRule ^sitemap\.xml$ /site-map.php
RewriteRule ^compare/$ /usercompare.php

RewriteRule ^page/([^/]*)$ /show_content.php?id=$1
RewriteRule ^content/([^/]*)$ /show_content.php?id=$1
RewriteRule ^gallery/([^/]*)$ /show_gallery.php?id=$1
RewriteRule ^forms/([^/]*)$ /show_forms.php?id=$1
RewriteRule ^product/([^/]*)/([^/]*)$ /show_product.php?id=$1
RewriteRule ^weblog/([^/]*)/([^/]*)$ /show_weblog.php?id=$1

RewriteRule ^CategoryProduct/([^/]*)$ /list_product.php?service=$1
RewriteRule ^CategoryProduct/([^/]*)/pagenumber/([^/]*)$  /list_product.php?service=$1&pagenumber=$2 
RewriteRule ^CategoryProduct/([^/]*)/sort/([^/]*)$  /list_product.php?service=$1&typesort=$2 
RewriteRule ^CategoryProduct/([^/]*)/search/([^/]*)$  /list_product.php?scope=$1&varsearch=$2 

RewriteRule ^CategoryWeblog/([^/]*)$ /list_weblog.php?service=$1
RewriteRule ^CategoryWeblog/([^/]*)/pagenumber/([^/]*)$  /list_weblog.php?service=$1&pagenumber=$2 
RewriteRule ^CategoryWeblog/([^/]*)/sort/([^/]*)$  /list_weblog.php?service=$1&typesort=$2 
RewriteRule ^CategoryWeblog/([^/]*)/search/([^/]*)$  /list_weblog.php?scope=$1&varsearch=$2 

RewriteRule ^search/([^/]*)$ /list_weblog.php?service=-2&varsearch=$1
RewriteRule ^search/([^/]*)/var/([^/]*)$ /list_weblog.php?service=$1&varsearch=$2 

RewriteRule ^thumb/([^/]*)$ /includee/thumbnil.php$1
RewriteRule ^calculator/([^/]*)$ /calculator_pro.php?type=$1

RewriteRule ^WebPayment/([^/]*)/([^/]*)/([^/]*)$ /ajaxpaymentservice.php?ShareId=$1&ListId=$2&token=$3
RewriteRule ^WebCallback/([^/]*)$ /reciveservice.php$1
RewriteRule ^callback/([^/]*)$ /recive.php$1
RewriteRule ^payment/([^/]*)$ /buy.php?id=$1

RewriteRule ^api/emalls([^/]*)$ /shop_api.php?type=emalls
RewriteRule ^api/torob([^/]*)$ /shop_api.php?type=torob

RewriteRule ^verify/([^/]*)$ /userverify.php?id=$1 [QSA,L]
RewriteRule ^register-gmail/$ /verify-token.php [L,QSA]
RewriteRule ^register-youtube/$ /verify-youtube.php [L,QSA]
RewriteRule ^z/([^/]*)$ /link.php?code=$1 [L]
RewriteRule ^llms\.txt$ /llms.php [L]


RewriteRule ^CodeGenerator/([^/]*)$ /includee/secureCodeGenerator.php$1
RewriteRule ^manifest\.json$ pwa-manifest.php [L]
RewriteRule ^service-worker\.js$ pwa-sw-generator.php [L]

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php74” package as the default “PHP” programming language.
#<IfModule mime_module>
#  AddHandler application/x-httpd-ea-php74 .php .php7 .phtml
#</IfModule>
# php -- END cPanel-generated handler, do not edit
